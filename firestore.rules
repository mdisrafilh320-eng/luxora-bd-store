rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_.@\\-]+$');
    }

    // Standard 3-Role Admin Helpers:
    //   - super_admin: Primary Owner / Super Admin
    //   - admin (or legacy supervisor): Store Admin / Supervisor
    //   - staff: Fulfillment Staff
    function docHasRole(data, allowedRoles) {
      return data.get('active', true) != false && (
        data.get('role', '') in allowedRoles ||
        (data.get('isAdmin', false) == true && ('admin' in allowedRoles))
      );
    }

    function hasAdminRole(allowedRoles) {
      return isSignedIn() && (
        (request.auth.token.email != null &&
          request.auth.token.email_verified == true &&
          request.auth.token.email.lower() == 'mdisrafilh320@gmail.com') ||
        (request.auth.token.email != null &&
          request.auth.token.email_verified == true &&
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
          docHasRole(get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data, allowedRoles)) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          docHasRole(get(/databases/$(database)/documents/admins/$(request.auth.uid)).data, allowedRoles)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in allowedRoles)
      );
    }

    function isSuperAdmin() {
      return hasAdminRole(['super_admin']);
    }

    function isManagerOrSuperAdmin() {
      return hasAdminRole(['super_admin', 'admin', 'store_admin', 'supervisor']);
    }

    function isAdmin() {
      return hasAdminRole(['super_admin', 'admin', 'store_admin', 'supervisor', 'staff']);
    }

    // --- USERS COLLECTION (Owner-Only PII Isolation + Manager/Super Admin Read) ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isManagerOrSuperAdmin());
      allow list: if isManagerOrSuperAdmin();
      allow create: if isValidId(userId) && (
        isSuperAdmin() ||
        (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == 'customer'))
      );
      allow update: if isValidId(userId) && (
        isSuperAdmin() ||
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'id', 'isAdmin'
        ]))
      );
      allow delete: if isValidId(userId) && isSuperAdmin();
    }

    // --- PRODUCTS COLLECTION (Public Read; Any Admin Create/Update; Manager/Super Admin Delete) ---
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create, update: if isValidId(productId) && isAdmin();
      allow delete: if isValidId(productId) && isManagerOrSuperAdmin();
    }

    // --- ALIAS LUXORA-PRODUCTS COLLECTION ---
    match /luxora-products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create, update: if isValidId(productId) && isAdmin();
      allow delete: if isValidId(productId) && isManagerOrSuperAdmin();
    }

    // --- CATEGORIES COLLECTION (Public Read; Manager/Super Admin Write) ---
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create, update, delete: if isValidId(categoryId) && isManagerOrSuperAdmin();
    }

    // --- BANNERS COLLECTION (Public Read; Manager/Super Admin Write) ---
    match /banners/{bannerId} {
      allow get: if isValidId(bannerId);
      allow list: if true;
      allow create, update, delete: if isValidId(bannerId) && isManagerOrSuperAdmin();
    }

    // --- ORDERS COLLECTION (Admins Full Order Management; Customer UID-Isolated) ---
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.get('userId', '') == request.auth.uid)
      );
      allow list: if isAdmin() || (
        isSignedIn() && resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && request.resource.data.get('userId', '') == request.auth.uid) ||
        (!isSignedIn() && request.resource.data.get('userId', '') == 'guest')
      );
      allow update: if isValidId(orderId) && isAdmin();
      allow delete: if isValidId(orderId) && isSuperAdmin();
    }

    // --- ADMINS COLLECTION (Self-Check + Store Admin Read-Only Directory; Super Admin Full Control) ---
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (
        isManagerOrSuperAdmin() ||
        (isSignedIn() && (
          adminId == request.auth.uid ||
          (request.auth.token.email != null && adminId == request.auth.token.email.lower())
        ))
      );
      allow list: if isManagerOrSuperAdmin();
      allow create, update, delete: if isValidId(adminId) && isSuperAdmin();
    }

    // --- SETTINGS COLLECTION (Public Storefront Read; Storefront Meta & Return Policy Manager+; AI/Logistics Admin+; Payment Super Admin Only) ---
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && (
        (settingId == 'logistics_sheets' || settingId == 'ai_training')
          ? isAdmin()
          : true
      );
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(settingId) && (
        (settingId == 'storefront_meta' || settingId == 'return_policy')
          ? isManagerOrSuperAdmin()
          : (settingId == 'ai_training' || settingId == 'logistics_sheets')
            ? isAdmin()
            : isSuperAdmin()
      );
    }

    // --- OMNICHANNEL AI SALES INBOX CONVERSATIONS (Admin Only) ---
    match /crm_conversations/{conversationId} {
      allow get, create, update, delete: if isValidId(conversationId) && isAdmin();
      allow list: if isAdmin();
    }

    // --- OMNICHANNEL CHANNEL WEBHOOK & API CREDENTIALS (Admin Only) ---
    match /omnichannel_channels/{channelId} {
      allow get, create, update, delete: if isValidId(channelId) && isAdmin();
      allow list: if isAdmin();
    }
  }
}
