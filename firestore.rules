rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Global security primitives & helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'mdisrafilh320@gmail.com') ||
        (request.auth.token.email != null &&
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
          get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role == 'super_admin' &&
          get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.active != false) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin' &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'] &&
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'mdisrafilh320@gmail.com' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email.lower() == 'mdisrafilh320@gmail.com'))
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          (request.auth.token.email != null &&
            exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
            get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.active != false) ||
          (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'staff'])
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_.@\\-]+$');
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])))
      );
      allow delete: if isValidId(userId) && isSuperAdmin();
    }

    // --- PRODUCTS COLLECTION (Public Catalog Worldwide, Admin/Staff Manageable) ---
    match /products/{productId} {
      allow read, write: if true;
    }

    // --- ALIAS LUXORA-PRODUCTS COLLECTION ---
    match /luxora-products/{productId} {
      allow read, write: if true;
    }

    // --- CATEGORIES COLLECTION (Public Taxonomy Worldwide, Admin/Staff Manageable) ---
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // --- ORDERS COLLECTION (Customers place orders, Staff & Admin Fulfill, Super Admin Deletes) ---
    match /orders/{orderId} {
      allow read: if isValidId(orderId);
      allow list: if true;
      allow create: if isValidId(orderId);
      allow update: if isValidId(orderId) && (isAdmin() || isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow delete: if isValidId(orderId) && (isAdmin() || isSuperAdmin());
    }

    // --- ADMINS COLLECTION (Whitelisted Admin Staff - Strictly Super Admin Writable) ---
    match /admins/{adminId} {
      allow read: if isValidId(adminId) && isAdmin();
      allow create, update, delete: if isValidId(adminId) && isSuperAdmin();
    }

    // --- SETTINGS COLLECTION (Public Read for Storefront/Checkout, Admin & Super Admin Writable) ---
    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isValidId(settingId);
    }
  }
}
