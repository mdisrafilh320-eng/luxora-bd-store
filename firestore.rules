rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Security Primitives & Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_.@\\-]+$');
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null &&
          request.auth.token.email_verified == true &&
          request.auth.token.email.lower() == 'mdisrafilh320@gmail.com') ||
        (request.auth.token.email != null &&
          request.auth.token.email_verified == true &&
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
          get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role == 'super_admin' &&
          get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.active != false) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin' &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false)
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          (request.auth.token.email != null &&
            request.auth.token.email_verified == true &&
            exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
            get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.active != false) ||
          (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'staff'])
        )
      );
    }

    // --- USERS COLLECTION (Strict Owner-Only PII Isolation + Anti-Privilege-Escalation) ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == 'customer'))
      );
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'id']))
      );
      allow delete: if isValidId(userId) && isSuperAdmin();
    }

    // --- PRODUCTS COLLECTION (Public Catalog Read, Strictly Admin-Only Write) ---
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create, update, delete: if isValidId(productId) && isAdmin();
    }

    // --- ALIAS LUXORA-PRODUCTS COLLECTION (Public Catalog Read, Strictly Admin-Only Write) ---
    match /luxora-products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create, update, delete: if isValidId(productId) && isAdmin();
    }

    // --- CATEGORIES COLLECTION (Public Taxonomy Read, Strictly Admin-Only Write) ---
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create, update, delete: if isValidId(categoryId) && isAdmin();
    }

    // --- BANNERS COLLECTION (Public Storefront Read, Strictly Admin-Only Write) ---
    match /banners/{bannerId} {
      allow get: if isValidId(bannerId);
      allow list: if true;
      allow create, update, delete: if isValidId(bannerId) && isAdmin();
    }

    // --- ORDERS COLLECTION (Strict UID Isolation for Customers, Full Access for Admins) ---
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );
      allow list: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
      allow create: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && request.resource.data.userId == request.auth.uid) ||
        (!isSignedIn() && request.resource.data.userId == 'guest')
      );
      allow update: if isValidId(orderId) && isAdmin();
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // --- ADMINS COLLECTION (Self-Verification Read Only, Strictly Super Admin Writable) ---
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (
        isAdmin() ||
        (isSignedIn() && (
          adminId == request.auth.uid ||
          (request.auth.token.email != null && adminId == request.auth.token.email.lower())
        ))
      );
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(adminId) && isSuperAdmin();
    }

    // --- SETTINGS COLLECTION (Storefront Config Read, Strictly Admin-Only Write) ---
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(settingId) && isAdmin();
    }
  }
}
